# Required. Replace with the output of: openssl rand -hex 32
CLIPO_SECRET_KEY=
CLIPO_BASE_URL=http://localhost:8000
CLIPO_DATABASE_URL=sqlite:///./data/clipo.db
CLIPO_LOG_LEVEL=INFO
CLIPO_REGISTRATION_OPEN=false
# 已验证的自动配置版 iCloud 链接；留空时网页显示安装指南。
# 不要使用包含真实 Token 的个人分享链接。
# CLIPO_SHORTCUT_INSTALL_URL=https://www.icloud.com/shortcuts/32位分享ID

# Compose always uses PostgreSQL; source development defaults to SQLite.
POSTGRES_USER=clipo
POSTGRES_PASSWORD=clipo-local-change-me
POSTGRES_DB=clipo

# Optional deployment overrides for settings entered in the web interface:
# CLIPO_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CLIPO_LLM_MODEL=qwen-plus
# CLIPO_LLM_API_KEY=

# API and worker must share this durable queue file:
# CLIPO_QUEUE_PATH=./data/huey.db
# CLIPO_EXTRACTION_CACHE_TTL_SECONDS=86400
